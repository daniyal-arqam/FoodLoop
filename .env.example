NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/foodloop
MONGO_PORT=27017

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080

# API Gateway
GATEWAY_PORT=8080
GATEWAY_URL=http://localhost:8080
PROXY_TIMEOUT_MS=10000
CORS_ORIGINS=*

# Auth Service
AUTH_SERVICE_PORT=4001
AUTH_SERVICE_URL=http://localhost:4001
JWT_SECRET=foodloop-local-dev-secret
JWT_EXPIRES_IN=1d

# Food Service
FOOD_SERVICE_PORT=4002
FOOD_SERVICE_URL=http://localhost:4002

# Organization Service
ORGANIZATION_SERVICE_PORT=4003
ORGANIZATION_SERVICE_URL=http://localhost:4003

# Matcher (Python)
MATCHER_PORT=8001
MATCHER_URL=http://localhost:8001

# AI Service (Python)
AI_SERVICE_PORT=8002
AI_SERVICE_URL=http://localhost:8002
AI_PROXY_TIMEOUT_MS=30000
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=25
FOODLOOP_TIMEOUT_SECONDS=10
AGENT_MAX_STEPS=8
