# Copy to the VPS as `.env` next to docker-compose.yml (never commit the filled file).
NODE_ENV=production

# Strong random string (openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Google OAuth Web client id (public). Optional.
GOOGLE_CLIENT_ID=

# Browser origins: Vercel URL, or * for an open demo
CORS_ORIGINS=*

GATEWAY_PORT=8080
PROXY_TIMEOUT_MS=60000
AI_PROXY_TIMEOUT_MS=55000

# Self-ping is optional (the VPS does not sleep like Render free)
KEEPALIVE_ENABLED=false

# Optional OpenAI key — demo LLM works without it
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# HTTPS profile only: DNS A-record for this hostname → droplet IP
# GATEWAY_DOMAIN=api.yourdomain.com
